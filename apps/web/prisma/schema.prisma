generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // Pastikan ini sesuai (postgresql/sqlite) dengan database yang Anda gunakan sebelumnya
  url      = env("DATABASE_URL")
}

model User {
  walletAddress   String   @id
  username        String   @unique
  email           String?  @unique
  isEmailVerified Boolean  @default(false)
  isVerified      Boolean  @default(false)
  socialMedia     String?
  avatarUrl       String?
  twitterHandle   String?
  bio             String?
  meritScore      Int      @default(0) // Merit Score 0-100
  tier            Int      @default(0) // Snapshot tier (band spec: 0 | 1-20 | 21-50 | 51-75 | 76-90 | 91-100)
  nonce           String   @default(cuid())

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  memberships     PoolMember[]
}

// Challenge nonce single-use untuk verifikasi kepemilikan wallet (auth endpoint mutasi)
model AuthChallenge {
  address   String   @id
  nonce     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Pool {
  id                 String   @id @default(cuid())
  poolIdOnChain      Int      @unique // ID pool yang akan sinkron dengan Smart Contract (0, 1, 2, dst)
  name               String   // Nama pool (Basic Pool, Standard Pool, dll)
  tierRequired       Int      @default(0)
  contributionAmount Float    // Jumlah iuran (50, 100, 200, 500)
  poolSize           Int      // Kapasitas member (3, 5, 10)
  totalYield         Float    @default(0) // Total hadiah (150, 500, 1000, 2500)
  isAuctionMode      Boolean  @default(false)

  // Fitur baru: Melacak pemenang siklus sebelumnya
  lastWinnerUsername String?
  lastWinnerAddress  String?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  members            PoolMember[]
}

// Keanggotaan user di pool (off-chain, disinkronkan setelah tx joinPool on-chain)
model PoolMember {
  userId   String
  poolId   String
  joinedAt DateTime @default(now()) // untuk tenure Merit Queue (spesifikasi §46)

  user User @relation(fields: [userId], references: [walletAddress], onDelete: Cascade)
  pool Pool @relation(fields: [poolId], references: [id], onDelete: Cascade)

  @@id([userId, poolId])
}

// Iuran per cycle (mirror event PoolJoined/ContributionPaid + hasil cron default-check)
model Contribution {
  id            String    @id @default(cuid())
  poolIdOnChain Int
  round         Int       @default(0)
  cycle         Int
  userWallet    String
  amount        Float
  dueAt         DateTime?
  paidAt        DateTime?
  status        String    @default("PAID") // PAID | LATE | MISSED
  txHash        String?
  createdAt     DateTime  @default(now())

  @@unique([poolIdOnChain, round, cycle, userWallet])
  @@index([userWallet])
}

// Lelang per cycle untuk pool auction (Tier 4-5)
model Auction {
  id            String   @id @default(cuid())
  poolIdOnChain Int
  round         Int      @default(0)
  cycle         Int
  opensAt       DateTime @default(now())
  closesAt      DateTime
  status        String   @default("OPEN") // OPEN | CLOSED
  winningBid    Float?
  winnerWallet  String?
  surplus       Float?

  bids Bid[]

  @@unique([poolIdOnChain, round, cycle])
}

// Bid auction (mirror event BidPlaced)
model Bid {
  id         String   @id @default(cuid())
  auctionId  String
  userWallet String
  amount     Float
  valid      Boolean  @default(true)
  txHash     String?
  createdAt  DateTime @default(now())

  auction Auction @relation(fields: [auctionId], references: [id], onDelete: Cascade)

  @@unique([auctionId, userWallet])
}

// Payout cycle (winner + konteks ekonomi; mirror event CycleSettled)
model Payout {
  id            String   @id @default(cuid())
  poolIdOnChain Int
  round         Int      @default(0)
  cycle         Int
  userWallet    String
  nominalAmount Float
  payoutAmount  Float
  discount      Float    @default(0) // nominal - payout (auction)
  surplus       Float    @default(0)
  txHash        String?
  status        String   @default("SETTLED")
  createdAt     DateTime @default(now())

  @@unique([poolIdOnChain, round, cycle])
  @@index([userWallet])
}

// Komitmen anggota terhadap satu pool-round penuh (spesifikasi §22)
model Obligation {
  id                String   @id @default(cuid())
  poolIdOnChain     Int
  round             Int      @default(0)
  userWallet        String
  totalCycles       Int
  contributedCycles Int      @default(0)
  missedCycles      Int      @default(0)
  status            String   @default("ACTIVE") // ACTIVE | COMPLETED | DEFAULTED
  updatedAt         DateTime @updatedAt

  @@unique([poolIdOnChain, round, userWallet])
  @@index([userWallet])
}

// Notifikasi in-app feed
model Notification {
  id         String   @id @default(cuid())
  userWallet String
  type       String // contribution_due | payment_success | auction_open | auction_result | default_warning | merit_change | payout
  title      String
  body       String
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([userWallet, read])
}

// Ledger perubahan merit (audit trail skor reputasi)
model ReputationEvent {
  id          String   @id @default(cuid())
  userWallet  String
  eventType   String // contribution_on_time | contribution_late | pool_completed | default | payout_received | adjustment
  pointsDelta Int
  detail      String?
  createdAt   DateTime @default(now())

  @@index([userWallet])
}

// Token verifikasi email (single-use, kadaluarsa 24 jam)
model EmailToken {
  id        String   @id @default(cuid())
  token     String   @unique
  email     String
  wallet    String
  expiresAt DateTime
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())
}

// Kursor indexer per stream agar tidak memproses blok dua kali
model IndexerCursor {
  id        String   @id // nama stream, mis. "meritpool-events"
  lastBlock Int
  updatedAt DateTime @updatedAt
}