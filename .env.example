# Server environment
NODE_ENV=development
PORT=4000

# PostgreSQL Database Connection
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Example Local: postgresql://postgres:postgres@localhost:5432/merit_circle?schema=public
# Example Docker: postgresql://postgres:postgres@127.0.0.1:5432/merit_circle?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/merit_circle?schema=public

# Authentication
JWT_SECRET=super_secret_jwt_passphrase_for_hackathon_demo_32chars_min
JWT_EXPIRES_IN=7d

# Email Verification Provider (console = prints OTP code to terminal)
EMAIL_PROVIDER=console
EMAIL_OTP_EXPIRES_MINUTES=10
EMAIL_OTP_MAX_REQUESTS_PER_HOUR=5

# Frontend Web Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# BNB Smart Chain Testnet
NEXT_PUBLIC_BNB_TESTNET_CHAIN_ID=97
NEXT_PUBLIC_BNB_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545/

# Smart Contract (BNB Smart Chain Testnet)
# CONTRACT_ADDRESS: Diisi setelah menjalankan 'pnpm --filter "@merit-circle/contracts" run deploy:testnet'
CONTRACT_ADDRESS=
NEXT_PUBLIC_CONTRACT_ADDRESS=
# DEPLOYER_PRIVATE_KEY: Private key akun deployer yang memiliki saldo tBNB (format: 0x...)
DEPLOYER_PRIVATE_KEY=
# NEXT_PUBLIC_DEMO_PAYMENT_MODE: Jika true, simulator pembayaran Web3 aktif untuk demo hackathon tanpa harus bayar gas real
NEXT_PUBLIC_DEMO_PAYMENT_MODE=true

# Optional Services
# Resend API Key jika EMAIL_PROVIDER=resend (https://resend.com)
RESEND_API_KEY=
EMAIL_FROM=noreply@meritcircle.local
FIGMA_FILE_KEY=
FIGMA_ACCESS_TOKEN=
