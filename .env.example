# ==============================================================================
# MERIT CIRCLE — ENVIRONMENT CONFIGURATION TEMPLATE
# Salin file ini menjadi apps/web/.env untuk konfigurasi lokal
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Prisma ORM)
# PostgreSQL connection string (mendukung Supabase / RDS / Docker lokal)
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/meritcircle?schema=public"

# ------------------------------------------------------------------------------
# 2. BLOCKCHAIN & RPC NETWORKING
# Chain ID target:
#   - 31337 : Anvil / Foundry Local Testnet
#   - 97    : BNB Smart Chain (BSC) Testnet
# ------------------------------------------------------------------------------
CHAIN_ID=31337
RPC_URL="http://127.0.0.1:8545"

# ------------------------------------------------------------------------------
# 3. BACKEND & KEEPER SIGNER KEYS
# Private key wallet backend untuk menandatangani otorisasi join & Merit Queue designation
# (JANGAN PERNAH commit private key produksi ke git!)
# Anvil Default Account #1 (untuk testing lokal):
# ------------------------------------------------------------------------------
BACKEND_PRIVATE_KEY="0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d"
KEEPER_PRIVATE_KEY="0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80"

# ------------------------------------------------------------------------------
# 4. SMART CONTRACT OVERRIDES (Opsional jika ingin override contracts.ts)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_MC_TOKEN_ADDRESS=""
NEXT_PUBLIC_TOKEN_SWAP_ADDRESS=""
NEXT_PUBLIC_MERIT_POOL_ADDRESS=""

# ------------------------------------------------------------------------------
# 5. AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
JWT_SECRET="super-secret-jwt-key-minimum-32-chars-long"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
