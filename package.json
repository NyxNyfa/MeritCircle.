{
  "name": "merit-circle",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:backend": "node scripts/sync-env.js && pnpm --filter \"@merit-circle/backend\" run dev",
    "dev:web": "node scripts/sync-env.js && pnpm --filter \"@merit-circle/web\" run dev",
    "prisma:generate": "pnpm --filter \"@merit-circle/backend\" run prisma:generate",
    "db:push": "node scripts/sync-env.js && pnpm --filter \"@merit-circle/backend\" run db:push",
    "db:seed-demo": "node scripts/sync-env.js && pnpm --filter \"@merit-circle/backend\" run db:seed-demo",
    "lint": "pnpm -r run --if-present lint",
    "typecheck": "pnpm -r run --if-present typecheck",
    "test": "pnpm -r run --if-present test",
    "postinstall": "pnpm prisma:generate",
    "prebuild": "pnpm prisma:generate",
    "build": "pnpm -r run --if-present build",
    "sim": "pnpm --filter \"@merit-circle/contracts\" run sim",
    "test:sim": "pnpm --filter \"@merit-circle/contracts\" run test:sim",
    "start:backend": "pnpm --filter \"@merit-circle/backend\" run start",
    "start:web": "pnpm --filter \"@merit-circle/web\" run start",
    "start": "pnpm run start:backend"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  }
}
